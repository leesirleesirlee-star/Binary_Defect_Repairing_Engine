# Keep repository text as LF so CI, hashes and diffs are stable on Windows.
* text=auto eol=lf

# Binary fixtures and images must not be normalized.
*.elf binary
*.bin binary
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
# G3 evidence is hash-bound: keep the bytes exactly as produced (do not normalize newlines).
/docs/plan/evidence/g3/*.json -text
