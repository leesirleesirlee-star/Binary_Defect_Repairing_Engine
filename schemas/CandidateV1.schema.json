{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CandidateV1",
  "description": "Applied-candidate record. M5 writes it when a candidate ELF is actually written from the approved FixPlanV1 and the dry-run EditManifestV1. The manifest itself stays dry-run (dry_run=true, candidate_written=false); this record is the truthful statement that a candidate exists. ADR 0004.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_written",
    "fixture_id",
    "original",
    "candidate",
    "plan",
    "manifest",
    "edits_applied",
    "reversibility",
    "produced_by",
    "produced_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_kind": {
      "type": "string"
    },
    "candidate_written": {
      "const": true
    },
    "fixture_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "original": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "plan_id"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "plan_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "edits_applied": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "address",
          "file_offset",
          "size",
          "new_sha256"
        ],
        "properties": {
          "kind": {
            "enum": [
              "redirect_call",
              "code",
              "data"
            ]
          },
          "address": {
            "type": "string",
            "pattern": "^0x[0-9a-f]+$"
          },
          "file_offset": {
            "type": "integer",
            "minimum": 0
          },
          "size": {
            "type": "integer",
            "minimum": 1
          },
          "new_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "reversibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "matches_original",
        "restored_sha256"
      ],
      "properties": {
        "matches_original": {
          "const": true
        },
        "restored_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "method": {
          "type": "string"
        }
      }
    },
    "produced_by": {
      "type": "string",
      "minLength": 1
    },
    "produced_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
