{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VerdictV1",
  "description": "The only success label is verified_against_stated_criteria. Produced by the deterministic verifier, never by the model or the GUI.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "verdict",
    "original_sha256",
    "criteria",
    "coverage",
    "limitations",
    "produced_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "verdict": {
      "enum": [
        "verified_against_stated_criteria",
        "rejected",
        "unverified",
        "unsupported",
        "error",
        "not_run"
      ]
    },
    "original_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidate_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "contract_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "required",
          "status",
          "evidence_sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "required": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "not_run"
            ]
          },
          "evidence_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cases_total",
        "cases_run",
        "unmeasured"
      ],
      "properties": {
        "cases_total": {
          "type": "integer",
          "minimum": 0
        },
        "cases_run": {
          "type": "integer",
          "minimum": 0
        },
        "unmeasured": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "produced_at": {
      "type": "string",
      "format": "date-time"
    },
    "produced_by": {
      "type": "string",
      "minLength": 1
    }
  }
}
