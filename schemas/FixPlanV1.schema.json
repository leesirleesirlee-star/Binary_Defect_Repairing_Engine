{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FixPlanV1",
  "description": "One model-proposed repair plan against a frozen contract. Input to the human G2 decision; never evidence by itself.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "fixture_id",
    "contract_sha256",
    "model",
    "target",
    "edits",
    "assumptions",
    "uncertainties"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "plan_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "fixture_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "contract_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "name",
        "prompt_sha256"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "prompt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "function",
        "edit_site_vaddr"
      ],
      "properties": {
        "function": {
          "type": "string",
          "minLength": 1
        },
        "edit_site_vaddr": {
          "type": "string",
          "pattern": "^0x[0-9a-f]+$"
        },
        "cave_vaddr": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^0x[0-9a-f]+$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "edits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "vaddr",
          "bytes_hex",
          "reason"
        ],
        "properties": {
          "kind": {
            "enum": [
              "redirect",
              "code",
              "data"
            ]
          },
          "vaddr": {
            "type": "string",
            "pattern": "^0x[0-9a-f]+$"
          },
          "bytes_hex": {
            "type": "string",
            "pattern": "^([0-9a-f]{2})*$",
            "minLength": 2
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
