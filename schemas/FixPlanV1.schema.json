{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FixPlanV1",
  "description": "One model-proposed repair plan against a frozen contract. Input to the human G2 decision; never evidence by itself.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "fixture_id",
    "contract_sha256",
    "model",
    "diagnosis",
    "root_cause",
    "strategy",
    "edits",
    "stub",
    "valid_path",
    "invalid_path",
    "stated_criteria_coverage",
    "assumptions",
    "uncertainties",
    "verification_proposal"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "plan_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "fixture_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "contract_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "name",
        "prompt_sha256"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "prompt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "diagnosis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "function",
        "address",
        "instruction",
        "cwe",
        "confidence",
        "evidence"
      ],
      "properties": {
        "function": {
          "type": "string",
          "minLength": 1
        },
        "address": {
          "type": "string",
          "pattern": "^0x[0-9a-f]+$"
        },
        "instruction": {
          "type": "string",
          "minLength": 1
        },
        "cwe": {
          "type": "string",
          "pattern": "^CWE-[0-9]+$"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "root_cause": {
      "type": "string",
      "minLength": 1
    },
    "strategy": {
      "type": "string",
      "minLength": 1,
      "description": "e.g. trampoline_guard"
    },
    "edits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "address",
          "original_bytes",
          "new_bytes"
        ],
        "properties": {
          "kind": {
            "enum": [
              "redirect_call",
              "code",
              "data",
              "guard_stub"
            ]
          },
          "address": {
            "type": "string",
            "pattern": "^0x[0-9a-f]+$"
          },
          "original_bytes": {
            "type": "string",
            "pattern": "^(([0-9a-f]{2})([ -]?[0-9a-f]{2})*)?$"
          },
          "new_bytes": {
            "type": "string",
            "pattern": "^(([0-9a-f]{2})([ -]?[0-9a-f]{2})*)?$"
          },
          "target": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "stub": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "source",
        "estimated_size_bytes"
      ],
      "properties": {
        "language": {
          "enum": [
            "asm",
            "pseudo"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "estimated_size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "valid_path": {
      "type": "string",
      "minLength": 1
    },
    "invalid_path": {
      "type": "string",
      "minLength": 1
    },
    "stated_criteria_coverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion",
          "how"
        ],
        "properties": {
          "criterion": {
            "type": "string",
            "minLength": 1
          },
          "how": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification_proposal": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
