{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContractV1",
  "description": "Stated criteria, allowed edits and environment assumptions for one fixture. Written by M1, frozen at G1, never generated by the model.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fixture_id",
    "target_function",
    "stated_criteria",
    "allowed_edits",
    "environment_assumptions",
    "binary_sha256",
    "criteria_source"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "fixture_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "target_function": {
      "type": "string",
      "minLength": 1
    },
    "stated_criteria": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capacity_bytes",
        "capacity_includes_terminator",
        "max_valid_input_bytes",
        "valid_domain",
        "valid_behavior",
        "forbidden_behavior",
        "invalid_response",
        "invalid_stderr"
      ],
      "properties": {
        "capacity_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "capacity_includes_terminator": {
          "type": "boolean"
        },
        "max_valid_input_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "valid_domain": {
          "type": "string",
          "minLength": 1
        },
        "valid_behavior": {
          "type": "string",
          "minLength": 1
        },
        "forbidden_behavior": {
          "type": "string",
          "minLength": 1
        },
        "invalid_response": {
          "type": "string",
          "minLength": 1
        },
        "invalid_stderr": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "allowed_edits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "redirect",
        "added_code",
        "added_data",
        "forbidden"
      ],
      "properties": {
        "redirect": {
          "type": "string",
          "minLength": 1
        },
        "added_code": {
          "type": "string",
          "minLength": 1
        },
        "added_data": {
          "type": "string",
          "minLength": 1
        },
        "forbidden": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "environment_assumptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "binary_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "criteria_source": {
      "enum": [
        "human_frozen",
        "derived_from_cases"
      ]
    },
    "diagnostic_hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "status"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "to_be_confirmed_by_analysis",
            "confirmed",
            "refuted"
          ]
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
