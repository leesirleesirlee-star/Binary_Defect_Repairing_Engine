{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DisassemblyViewV1",
  "description": "Deterministic ELF facts and function-sliced disassembly. The only binary material the model may see; it must contain no source path, DWARF line table or source text.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "elf",
    "segments",
    "symbols",
    "instructions",
    "plt",
    "sections"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "elf": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "class",
        "machine",
        "type",
        "entry",
        "pie"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "class": {
          "enum": [
            "ELF64"
          ]
        },
        "machine": {
          "enum": [
            "x86-64",
            "EM_X86_64"
          ]
        },
        "type": {
          "enum": [
            "ET_EXEC",
            "ET_DYN"
          ]
        },
        "entry": {
          "type": "string",
          "pattern": "^0x[0-9a-f]+$"
        },
        "pie": {
          "type": "boolean"
        }
      }
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "vaddr",
          "filesz",
          "memsz",
          "flags"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "vaddr": {
            "type": "string",
            "pattern": "^0x[0-9a-f]+$"
          },
          "filesz": {
            "type": "integer",
            "minimum": 0
          },
          "memsz": {
            "type": "integer",
            "minimum": 0
          },
          "flags": {
            "type": "string",
            "pattern": "^[R-][W-][X-]$"
          }
        }
      }
    },
    "symbols": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^0x[0-9a-f]+$"
      }
    },
    "instructions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "address",
          "bytes",
          "mnemonic",
          "op_str"
        ],
        "properties": {
          "address": {
            "type": "string",
            "pattern": "^0x[0-9a-f]+$"
          },
          "bytes": {
            "type": "string",
            "pattern": "^([0-9a-f]{2})([ -]?[0-9a-f]{2})*$"
          },
          "mnemonic": {
            "type": "string",
            "minLength": 1
          },
          "op_str": {
            "type": "string"
          }
        }
      }
    },
    "plt": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^0x[0-9a-f]+$"
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "vaddr",
          "size",
          "flags"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "vaddr": {
            "type": "string",
            "pattern": "^0x[0-9a-f]+$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "flags": {
            "type": "string"
          }
        }
      }
    }
  }
}
