{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ObservationV1",
  "description": "Guest-recorded behaviour of one binary over a case set. Baseline for candidate comparison.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "binary",
    "environment",
    "started_at",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "binary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uname",
        "kernel",
        "libc"
      ],
      "properties": {
        "uname": {
          "type": "string"
        },
        "kernel": {
          "type": "string"
        },
        "libc": {
          "type": "string"
        }
      }
    },
    "guest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "argv_sha256",
          "exit_code",
          "signal",
          "stdout_b64",
          "stderr_b64",
          "duration_ms",
          "timed_out"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "argv_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "exit_code": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "signal": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "stdout_b64": {
            "type": "string",
            "pattern": "^[A-Za-z0-9+/]*={0,2}$"
          },
          "stderr_b64": {
            "type": "string",
            "pattern": "^[A-Za-z0-9+/]*={0,2}$"
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0
          },
          "timed_out": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
